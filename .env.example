# Environment values referenced by ${VAR} macros in kb-config.yaml
# (embeddings / decisions sections). Copy to <vault-root>/.env (committable
# team defaults) and/or <vault-root>/.env.local (gitignored personal
# overrides). Precedence: process environment > .env.local > .env > the
# macro's :-default inside kb-config.yaml, if any.

# Base URL of the Ollama-compatible inference server shared by the vault
# tooling (embeddings via /api/embed, decisions via /v1/systemone).
WIKI_OLLAMA_URL=http://127.0.0.1:11434

# Optional finer-grained macro inputs (only if kb-config.yaml uses them):
# WIKI_SEM_MODEL=bge-m3
# WIKI_VET_MODEL=clef-flash:9b
