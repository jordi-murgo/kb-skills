# Inference endpoints for the vault tooling (wiki-semsearch, wiki-vetting).
# Copy to <vault-root>/.env (committable team defaults) and/or
# <vault-root>/.env.local (gitignored personal overrides).
# Precedence: process environment > .env.local > .env > built-in defaults.

# Shared: base URL of the Ollama-compatible inference server
# (embeddings via /api/embed, decisions via /v1/systemone).
WIKI_OLLAMA_URL=http://127.0.0.1:11434

# Specific overrides (optional; they beat WIKI_OLLAMA_URL):
# WIKI_SEM_ENDPOINT=      # embeddings server base URL (/api/embed appended)
# WIKI_SEM_MODEL=bge-m3
# WIKI_SEM_DB=            # index path override
# WIKI_SEM_NO_FTS5=1      # force fallback inverted index
# WIKI_VET_ENDPOINT=      # decision server base URL (/v1/systemone appended)
# WIKI_VET_MODEL=clef-flash:9b
